# Copy to .env (or set in your shell). Never commit real keys.

# Source spreadsheet used for ingestion (UAT: mock leasing data)
SOURCE_XLSX=C:\Users\justin.fan\Downloads\mock leasing data.xlsx

# SQLite is the free local default. Override with a PostgreSQL URL when available.
# DATABASE_URL=sqlite:///C:/Users/justin.fan/Downloads/RAGs2Riches/data/deals.db

# Default LLM selection: template | ollama | openai_compatible | anthropic | openai
LLM_PROVIDER=template
LLM_MODEL=

# Local runtimes (free)
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1
OPENAI_COMPATIBLE_API_KEY=not-needed

# Cloud providers (optional, paid). Keys are read from the environment only.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
